# Neon PostgreSQL connection string (use the pooled endpoint when available)
DATABASE_URL=jdbc:postgresql://ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_USERNAME=neondb_owner
DATABASE_PASSWORD=your-neon-password

# JWT (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION_MS=86400000

# Frontend origin for CORS (comma-separated for multiple)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://commonground-volunteer.vercel.app,https://volunteer-management.vercel.app

# Gemini assistant (server-side only — never put this key in the frontend or Android APK)
# AI Studio keys may start with AQ. (auth keys, default since May 2026) or AIza… (legacy).
# Set the same vars on Render → Environment, then redeploy.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_ENABLED=true
